# ── Deployer ─────────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ── RPC endpoints ─────────────────────────────────────────────────────────────
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARB_ONE_RPC=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC=https://rpc.robinhoodchain.com   # TODO: verify official RPC

# ── Block explorers ───────────────────────────────────────────────────────────
ARBISCAN_KEY=your_arbiscan_api_key

# ── Chainlink VRF v2.5 (Arbitrum Sepolia / One) ───────────────────────────────
# 1. Create subscription at https://vrf.chain.link
# 2. Fund with LINK (https://faucets.chain.link for testnet LINK)
# 3. Add CircleFactory address as a consumer after deploy
# 4. Paste subscription ID here
VRF_SUBSCRIPTION_ID=0

# ── Chainlink Automation ──────────────────────────────────────────────────────
# After deploying circles, register each at https://automation.chain.link
# Use "Custom Logic" upkeep type, target = circle contract address
